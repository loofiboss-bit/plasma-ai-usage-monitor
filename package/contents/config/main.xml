<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
      http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
    <kcfgfile name=""/>

    <group name="General">
        <entry name="refreshInterval" type="Int">
            <default>300</default>
            <label>Default refresh interval in seconds</label>
        </entry>
        <entry name="compactDisplayMode" type="String">
            <default>icon</default>
            <label>What to show in compact mode: icon, cost, count, dailycost, requests, critical</label>
        </entry>
        <entry name="setupWizardCompleted" type="Bool">
            <default>false</default>
            <label>Whether the first-run setup wizard has been completed</label>
        </entry>
        <entry name="setupWizardDismissed" type="Bool">
            <default>false</default>
            <label>Whether the first-run setup wizard was dismissed</label>
        </entry>
        <entry name="setupWizardInProgress" type="Bool">
            <default>false</default>
            <label>Whether guided setup should resume in the widget</label>
        </entry>
        <entry name="setupWizardStep" type="Int">
            <default>0</default>
            <label>Last resumable guided setup step</label>
        </entry>
        <entry name="setupWizardGoal" type="String">
            <default></default>
            <label>Selected guided setup goal</label>
        </entry>
        <entry name="setupWizardSourceId" type="String">
            <default></default>
            <label>Selected guided setup source identifier</label>
        </entry>
        <entry name="advancedSettingsMode" type="Bool">
            <default>false</default>
            <label>Whether advanced settings mode is enabled in config</label>
        </entry>
        <entry name="settingsVerificationRequestId" type="Int">
            <default>0</default>
            <label>Monotonic request identifier for provider verification from Settings</label>
        </entry>
        <entry name="settingsVerificationCompletedRequestId" type="Int">
            <default>0</default>
            <label>Last Settings verification request completed by the runtime</label>
        </entry>
        <entry name="settingsVerificationSourceId" type="String">
            <default></default>
            <label>Provider source selected for Settings verification</label>
        </entry>
        <entry name="settingsVerificationState" type="String">
            <default></default>
            <label>Typed readiness state returned by Settings verification</label>
        </entry>
        <entry name="settingsVerificationMessage" type="String">
            <default></default>
            <label>Redacted Settings verification result</label>
        </entry>
        <entry name="settingsVerificationTimestamp" type="String">
            <default></default>
            <label>UTC timestamp for the last Settings verification result</label>
        </entry>
        <entry name="dashboardMode" type="String">
            <default>operator</default>
            <label>Popup mode: simple, operator, or analyst</label>
        </entry>
        <entry name="showOnlyProblems" type="Bool">
            <default>false</default>
            <label>Show only providers and tools that need attention</label>
        </entry>

        <!-- Per-provider refresh intervals (0 = use global default) -->
        <entry name="openaiRefreshInterval" type="Int">
            <default>0</default>
        </entry>
        <entry name="anthropicRefreshInterval" type="Int">
            <default>0</default>
        </entry>
        <entry name="googleRefreshInterval" type="Int">
            <default>0</default>
        </entry>
        <entry name="mistralRefreshInterval" type="Int">
            <default>0</default>
        </entry>
        <entry name="deepseekRefreshInterval" type="Int">
            <default>0</default>
        </entry>
        <entry name="groqRefreshInterval" type="Int">
            <default>0</default>
        </entry>
        <entry name="xaiRefreshInterval" type="Int">
            <default>0</default>
        </entry>
        <entry name="ollamaRefreshInterval" type="Int">
            <default>0</default>
        </entry>
        <entry name="openrouterRefreshInterval" type="Int">
            <default>0</default>
        </entry>
        <entry name="togetherRefreshInterval" type="Int">
            <default>0</default>
        </entry>
        <entry name="cohereRefreshInterval" type="Int">
            <default>0</default>
        </entry>
        <entry name="googleveoRefreshInterval" type="Int">
            <default>0</default>
        </entry>
        <entry name="azureRefreshInterval" type="Int">
            <default>0</default>
        </entry>
        <entry name="bedrockRefreshInterval" type="Int">
            <default>0</default>
        </entry>
        <entry name="litellmRefreshInterval" type="Int"><default>0</default></entry>
        <entry name="cerebrasRefreshInterval" type="Int"><default>0</default></entry>
        <entry name="fireworksRefreshInterval" type="Int"><default>0</default></entry>
        <entry name="perplexityRefreshInterval" type="Int"><default>0</default></entry>
    </group>

    <group name="Providers">
        <!-- OpenAI -->
        <entry name="openaiEnabled" type="Bool">
            <default>false</default>
        </entry>
        <entry name="openaiModel" type="String">
            <default>gpt-5.6-terra</default>
        </entry>
        <entry name="openaiProjectId" type="String">
            <default></default>
        </entry>
        <entry name="openaiCustomBaseUrl" type="String">
            <default></default>
        </entry>

        <!-- Azure OpenAI -->
        <entry name="azureEnabled" type="Bool">
            <default>false</default>
        </entry>
        <entry name="azureModel" type="String">
            <default>gpt-5.4</default>
        </entry>
        <entry name="azureDeploymentId" type="String">
            <default></default>
        </entry>
        <entry name="azureCustomBaseUrl" type="String">
            <default></default>
        </entry>

        <!-- AWS Bedrock -->
        <entry name="bedrockEnabled" type="Bool">
            <default>false</default>
        </entry>
        <entry name="bedrockRegion" type="String">
            <default>us-east-1</default>
        </entry>
        <entry name="bedrockModel" type="String">
            <default>anthropic.claude-sonnet-4-20250514-v1:0</default>
        </entry>
        <entry name="bedrockCustomBaseUrl" type="String">
            <default></default>
        </entry>

        <!-- Anthropic -->
        <entry name="anthropicEnabled" type="Bool">
            <default>false</default>
        </entry>
        <entry name="anthropicModel" type="String">
            <default>claude-sonnet-5</default>
        </entry>
        <entry name="anthropicCustomBaseUrl" type="String">
            <default></default>
        </entry>

        <!-- Google -->
        <entry name="googleEnabled" type="Bool">
            <default>false</default>
        </entry>
        <entry name="googleModel" type="String">
            <default>gemini-3.1-flash-lite</default>
        </entry>
        <entry name="googleTier" type="String">
            <default>free</default>
        </entry>
        <entry name="googleCustomBaseUrl" type="String">
            <default></default>
        </entry>

        <!-- Mistral AI -->
        <entry name="mistralEnabled" type="Bool">
            <default>false</default>
        </entry>
        <entry name="mistralModel" type="String">
            <default>mistral-medium-3-5</default>
        </entry>
        <entry name="mistralCustomBaseUrl" type="String">
            <default></default>
        </entry>

        <!-- DeepSeek -->
        <entry name="deepseekEnabled" type="Bool">
            <default>false</default>
        </entry>
        <entry name="deepseekModel" type="String">
            <default>deepseek-v4-flash</default>
        </entry>
        <entry name="deepseekCustomBaseUrl" type="String">
            <default></default>
        </entry>

        <!-- Groq -->
        <entry name="groqEnabled" type="Bool">
            <default>false</default>
        </entry>
        <entry name="groqModel" type="String">
            <default>openai/gpt-oss-120b</default>
        </entry>
        <entry name="groqCustomBaseUrl" type="String">
            <default></default>
        </entry>

        <!-- xAI / Grok -->
        <entry name="xaiEnabled" type="Bool">
            <default>false</default>
        </entry>
        <entry name="xaiModel" type="String">
            <default>grok-4.5</default>
        </entry>
        <entry name="xaiCustomBaseUrl" type="String">
            <default></default>
        </entry>

        <!-- Ollama Cloud -->
        <entry name="ollamaEnabled" type="Bool">
            <default>false</default>
        </entry>
        <entry name="ollamaModel" type="String">
            <default>gpt-oss:120b-cloud</default>
        </entry>
        <entry name="ollamaCustomBaseUrl" type="String">
            <default></default>
        </entry>

        <!-- OpenRouter -->
        <entry name="openrouterEnabled" type="Bool">
            <default>false</default>
        </entry>
        <entry name="openrouterModel" type="String">
            <default>openai/gpt-5.6-terra</default>
        </entry>
        <entry name="openrouterCustomBaseUrl" type="String">
            <default></default>
        </entry>

        <!-- Together AI -->
        <entry name="togetherEnabled" type="Bool">
            <default>false</default>
        </entry>
        <entry name="togetherModel" type="String">
            <default>meta-llama/Llama-3.3-70B-Instruct-Turbo</default>
        </entry>
        <entry name="togetherCustomBaseUrl" type="String">
            <default></default>
        </entry>

        <!-- Cohere -->
        <entry name="cohereEnabled" type="Bool">
            <default>false</default>
        </entry>
        <entry name="cohereModel" type="String">
            <default>command-a-plus-05-2026</default>
        </entry>
        <entry name="cohereCustomBaseUrl" type="String">
            <default></default>
        </entry>

        <!-- Google Veo -->
        <entry name="googleveoEnabled" type="Bool">
            <default>false</default>
        </entry>
        <entry name="googleveoModel" type="String">
            <default>veo-3.1-generate-preview</default>
        </entry>
        <entry name="googleveoTier" type="String">
            <default>paid</default>
        </entry>
        <entry name="googleveoCustomBaseUrl" type="String">
            <default></default>
        </entry>

        <!-- Catalog v5 descriptor-driven providers -->
        <entry name="litellmEnabled" type="Bool"><default>false</default></entry>
        <entry name="litellmModel" type="String"><default>gateway-default</default></entry>
        <entry name="litellmCustomBaseUrl" type="String"><default></default></entry>
        <entry name="cerebrasEnabled" type="Bool"><default>false</default></entry>
        <entry name="cerebrasModel" type="String"><default>llama-4-scout-17b-16e-instruct</default></entry>
        <entry name="cerebrasCustomBaseUrl" type="String"><default></default></entry>
        <entry name="fireworksEnabled" type="Bool"><default>false</default></entry>
        <entry name="fireworksModel" type="String"><default>accounts/fireworks/models/llama-v3p3-70b-instruct</default></entry>
        <entry name="fireworksCustomBaseUrl" type="String"><default></default></entry>
        <entry name="perplexityEnabled" type="Bool"><default>false</default></entry>
        <entry name="perplexityModel" type="String"><default>perplexity/sonar</default></entry>
        <entry name="perplexityCustomBaseUrl" type="String"><default></default></entry>
    </group>

    <group name="Alerts">
        <entry name="alertsEnabled" type="Bool">
            <default>true</default>
        </entry>
        <entry name="warningThreshold" type="Int">
            <default>80</default>
            <label>Percentage of rate limit to trigger warning</label>
        </entry>
        <entry name="criticalThreshold" type="Int">
            <default>95</default>
            <label>Percentage of rate limit to trigger critical alert</label>
        </entry>
        <entry name="notifyOnError" type="Bool">
            <default>true</default>
        </entry>
        <entry name="notifyOnBudgetWarning" type="Bool">
            <default>true</default>
        </entry>
        <entry name="notifyOnDisconnect" type="Bool">
            <default>true</default>
        </entry>
        <entry name="notifyOnReconnect" type="Bool">
            <default>false</default>
        </entry>
        <entry name="notificationCooldownMinutes" type="Int">
            <default>15</default>
            <label>Minimum minutes between repeated notifications</label>
        </entry>
        <entry name="dndStartHour" type="Int">
            <default>-1</default>
            <label>Do-not-disturb start hour (-1 = disabled)</label>
        </entry>
        <entry name="dndEndHour" type="Int">
            <default>-1</default>
            <label>Do-not-disturb end hour (-1 = disabled)</label>
        </entry>

        <!-- Per-provider notification toggles -->
        <entry name="openaiNotificationsEnabled" type="Bool">
            <default>true</default>
        </entry>
        <entry name="anthropicNotificationsEnabled" type="Bool">
            <default>true</default>
        </entry>
        <entry name="googleNotificationsEnabled" type="Bool">
            <default>true</default>
        </entry>
        <entry name="mistralNotificationsEnabled" type="Bool">
            <default>true</default>
        </entry>
        <entry name="deepseekNotificationsEnabled" type="Bool">
            <default>true</default>
        </entry>
        <entry name="groqNotificationsEnabled" type="Bool">
            <default>true</default>
        </entry>
        <entry name="xaiNotificationsEnabled" type="Bool">
            <default>true</default>
        </entry>
        <entry name="ollamaNotificationsEnabled" type="Bool">
            <default>true</default>
        </entry>
        <entry name="openrouterNotificationsEnabled" type="Bool">
            <default>true</default>
        </entry>
        <entry name="togetherNotificationsEnabled" type="Bool">
            <default>true</default>
        </entry>
        <entry name="cohereNotificationsEnabled" type="Bool">
            <default>true</default>
        </entry>
        <entry name="googleveoNotificationsEnabled" type="Bool">
            <default>true</default>
        </entry>
        <entry name="azureNotificationsEnabled" type="Bool">
            <default>true</default>
        </entry>
        <entry name="bedrockNotificationsEnabled" type="Bool">
            <default>true</default>
        </entry>
        <entry name="litellmNotificationsEnabled" type="Bool"><default>true</default></entry>
        <entry name="cerebrasNotificationsEnabled" type="Bool"><default>true</default></entry>
        <entry name="fireworksNotificationsEnabled" type="Bool"><default>true</default></entry>
        <entry name="perplexityNotificationsEnabled" type="Bool"><default>true</default></entry>
        <!-- Update notifications -->
        <entry name="notifyOnUpdate" type="Bool">
            <default>true</default>
            <label>Show notification when a new version is available</label>
        </entry>
        <entry name="updateCheckInterval" type="Int">
            <default>12</default>
            <label>Hours between update checks</label>
        </entry>
        <entry name="slackWebhookEnabled" type="Bool">
            <default>false</default>
        </entry>
        <entry name="discordWebhookEnabled" type="Bool">
            <default>false</default>
        </entry>
        <entry name="webhookCooldownMinutes" type="Int">
            <default>15</default>
        </entry>
    </group>

    <group name="Budget">
        <!-- Budget values are stored in cents (integer) to avoid floating-point issues.
             e.g. 1050 = $10.50. The SpinBox in configBudget.qml works in cents natively. -->
        <entry name="openaiDailyBudget" type="Int">
            <default>0</default>
        </entry>
        <entry name="openaiMonthlyBudget" type="Int">
            <default>0</default>
        </entry>
        <entry name="anthropicDailyBudget" type="Int">
            <default>0</default>
        </entry>
        <entry name="anthropicMonthlyBudget" type="Int">
            <default>0</default>
        </entry>
        <entry name="googleDailyBudget" type="Int">
            <default>0</default>
        </entry>
        <entry name="googleMonthlyBudget" type="Int">
            <default>0</default>
        </entry>
        <entry name="mistralDailyBudget" type="Int">
            <default>0</default>
        </entry>
        <entry name="mistralMonthlyBudget" type="Int">
            <default>0</default>
        </entry>
        <entry name="deepseekDailyBudget" type="Int">
            <default>0</default>
        </entry>
        <entry name="deepseekMonthlyBudget" type="Int">
            <default>0</default>
        </entry>
        <entry name="groqDailyBudget" type="Int">
            <default>0</default>
        </entry>
        <entry name="groqMonthlyBudget" type="Int">
            <default>0</default>
        </entry>
        <entry name="xaiDailyBudget" type="Int">
            <default>0</default>
        </entry>
        <entry name="xaiMonthlyBudget" type="Int">
            <default>0</default>
        </entry>
        <entry name="ollamaDailyBudget" type="Int">
            <default>0</default>
        </entry>
        <entry name="ollamaMonthlyBudget" type="Int">
            <default>0</default>
        </entry>
        <entry name="openrouterDailyBudget" type="Int">
            <default>0</default>
        </entry>
        <entry name="openrouterMonthlyBudget" type="Int">
            <default>0</default>
        </entry>
        <entry name="togetherDailyBudget" type="Int">
            <default>0</default>
        </entry>
        <entry name="togetherMonthlyBudget" type="Int">
            <default>0</default>
        </entry>
        <entry name="cohereDailyBudget" type="Int">
            <default>0</default>
        </entry>
        <entry name="cohereMonthlyBudget" type="Int">
            <default>0</default>
        </entry>
        <entry name="googleveoDailyBudget" type="Int">
            <default>0</default>
        </entry>
        <entry name="googleveoMonthlyBudget" type="Int">
            <default>0</default>
        </entry>
        <entry name="azureDailyBudget" type="Int">
            <default>0</default>
        </entry>
        <entry name="azureMonthlyBudget" type="Int">
            <default>0</default>
        </entry>
        <entry name="bedrockDailyBudget" type="Int">
            <default>0</default>
        </entry>
        <entry name="bedrockMonthlyBudget" type="Int">
            <default>0</default>
        </entry>
        <entry name="litellmDailyBudget" type="Int"><default>0</default></entry>
        <entry name="litellmMonthlyBudget" type="Int"><default>0</default></entry>
        <entry name="cerebrasDailyBudget" type="Int"><default>0</default></entry>
        <entry name="cerebrasMonthlyBudget" type="Int"><default>0</default></entry>
        <entry name="fireworksDailyBudget" type="Int"><default>0</default></entry>
        <entry name="fireworksMonthlyBudget" type="Int"><default>0</default></entry>
        <entry name="perplexityDailyBudget" type="Int"><default>0</default></entry>
        <entry name="perplexityMonthlyBudget" type="Int"><default>0</default></entry>
        <entry name="budgetWarningPercent" type="Int">
            <default>80</default>
            <label>Percentage of budget to trigger a warning</label>
        </entry>
    </group>

    <group name="History">
        <entry name="historyEnabled" type="Bool">
            <default>true</default>
        </entry>
        <entry name="historyRetentionDays" type="Int">
            <default>90</default>
            <label>Number of days to keep usage history</label>
        </entry>
        <entry name="analystIntensityMode" type="Int">
            <default>0</default>
            <label>Heatmap intensity mode: 0=Cost, 1=Volume</label>
        </entry>
        <entry name="analystNormalization" type="Bool">
            <default>true</default>
            <label>Enable outlier normalization for heatmap</label>
        </entry>
        <entry name="prometheusEnabled" type="Bool">
            <default>false</default>
        </entry>
        <entry name="prometheusPort" type="Int">
            <default>9464</default>
        </entry>
        <entry name="autoExportEnabled" type="Bool">
            <default>false</default>
        </entry>
        <entry name="autoExportDirectory" type="String">
            <default></default>
        </entry>
        <entry name="autoExportIntervalMinutes" type="Int">
            <default>60</default>
        </entry>
        <entry name="autoExportFormat" type="String">
            <default>both</default>
        </entry>
    </group>

    <group name="Subscriptions">
        <!-- Browser Sync (experimental) -->
        <entry name="browserSyncEnabled" type="Bool">
            <default>false</default>
            <label>Enable experimental browser cookie sync for real-time usage data</label>
        </entry>
        <entry name="browserSyncBrowser" type="Int">
            <default>0</default>
            <label>Browser type: 0=Firefox, 1=Chrome, 2=Chromium, 3=Brave.</label>
        </entry>
        <entry name="browserSyncProfile" type="String">
            <default></default>
            <label>Browser profile name to use for browser sync (empty = auto/default)</label>
        </entry>
        <entry name="browserSyncInterval" type="Int">
            <default>300</default>
            <label>Browser sync refresh interval in seconds</label>
        </entry>

        <!-- Claude Code -->
        <entry name="claudeCodeEnabled" type="Bool">
            <default>false</default>
        </entry>
        <entry name="claudeCodePlan" type="Int">
            <default>0</default>
            <label>Plan index: 0=Pro, 1=Max 5x, 2=Max 20x</label>
        </entry>
        <entry name="claudeCodePlanId" type="String">
            <default>pro</default>
            <label>Stable Claude Code plan ID from subscriptions-v1.json</label>
        </entry>
        <entry name="claudeCodeCustomLimit" type="Int">
            <default>0</default>
            <label>Custom usage limit per 5h period (0 = use plan default)</label>
        </entry>
        <entry name="claudeCodeNotifications" type="Bool">
            <default>true</default>
        </entry>

        <!-- Codex CLI -->
        <entry name="codexEnabled" type="Bool">
            <default>false</default>
        </entry>
        <entry name="codexPlan" type="Int">
            <default>0</default>
            <label>Plan index: 0=Plus, 1=Pro, 2=Business</label>
        </entry>
        <entry name="codexPlanId" type="String">
            <default>plus</default>
            <label>Stable Codex CLI plan ID from subscriptions-v1.json</label>
        </entry>
        <entry name="codexCustomLimit" type="Int">
            <default>0</default>
            <label>Custom usage limit per 5h period (0 = use plan default)</label>
        </entry>
        <entry name="codexNotifications" type="Bool">
            <default>true</default>
        </entry>

        <!-- GitHub Copilot -->
        <entry name="copilotEnabled" type="Bool">
            <default>false</default>
        </entry>
        <entry name="copilotPlan" type="Int">
            <default>0</default>
            <label>Plan index: 0=Free, 1=Pro, 2=Pro+, 3=Business, 4=Enterprise</label>
        </entry>
        <entry name="copilotPlanId" type="String">
            <default>free</default>
            <label>Stable GitHub Copilot plan ID from subscriptions-v1.json</label>
        </entry>
        <entry name="copilotCustomLimit" type="Int">
            <default>0</default>
            <label>Custom monthly premium request limit (0 = use plan default)</label>
        </entry>
        <entry name="copilotBillingMode" type="String">
            <default>auto</default>
            <label>Copilot billing mode: auto, premium_requests_legacy, or ai_credits_usage_based</label>
        </entry>
        <entry name="copilotResetDay" type="Int">
            <default>1</default>
            <label>Monthly reset day in UTC, clamped to 1-28</label>
        </entry>
        <entry name="copilotNotifications" type="Bool">
            <default>true</default>
        </entry>
        <entry name="copilotOrgName" type="String">
            <default></default>
            <label>GitHub organization name for Copilot billing API</label>
        </entry>

        <!-- Cursor -->
        <entry name="cursorEnabled" type="Bool">
            <default>false</default>
        </entry>
        <entry name="cursorPlan" type="Int">
            <default>0</default>
        </entry>
        <entry name="cursorPlanId" type="String">
            <default>pro</default>
            <label>Stable Cursor plan ID from subscriptions-v1.json</label>
        </entry>
        <entry name="cursorCustomLimit" type="Int">
            <default>0</default>
        </entry>
        <entry name="cursorNotifications" type="Bool">
            <default>true</default>
        </entry>

        <!-- Windsurf -->
        <entry name="windsurfEnabled" type="Bool">
            <default>false</default>
        </entry>
        <entry name="windsurfPlan" type="Int">
            <default>0</default>
        </entry>
        <entry name="windsurfPlanId" type="String">
            <default>pro</default>
            <label>Stable Windsurf plan ID from subscriptions-v1.json</label>
        </entry>
        <entry name="windsurfCustomLimit" type="Int">
            <default>0</default>
        </entry>
        <entry name="windsurfNotifications" type="Bool">
            <default>true</default>
        </entry>

        <!-- JetBrains AI -->
        <entry name="jetbrainsAiEnabled" type="Bool">
            <default>false</default>
        </entry>
        <entry name="jetbrainsAiPlan" type="Int">
            <default>0</default>
        </entry>
        <entry name="jetbrainsAiPlanId" type="String">
            <default>ai_free</default>
            <label>Stable JetBrains AI plan ID from subscriptions-v1.json</label>
        </entry>
        <entry name="jetbrainsAiCustomLimit" type="Int">
            <default>0</default>
        </entry>
        <entry name="jetbrainsAiNotifications" type="Bool">
            <default>true</default>
        </entry>
    </group>
</kcfg>
